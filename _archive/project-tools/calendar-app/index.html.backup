                courseWeight: '20% total (23 posts)',
                dueTime: '9:00pm',
                requirements: '250 words responding to prompt or offering analysis of week\'s readings/viewings',
                tips: 'Post before 9pm to avoid late penalty. No post needed on presentation days.',
                prepTime: 'Same day (1-2 hours)'
            },
