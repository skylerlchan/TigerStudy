                prepTime: '2-3 days recommended'
            },
            'mus262-quiz2': {
                title: 'MUS262 Quiz #2',
                weight: '7.5% of final grade',
                courseWeight: '15% total (2 quizzes)',
                dueTime: 'In class',
                requirements: 'Covers material from Weeks 1-4 (Early Jazz through Bebop)',
                tips: 'Review listening assignments and study guides. Know key artists and characteristics.',
                prepTime: '2-3 days of review'
            },
            'eco310-ps3': {
                title: 'ECO310 Problem Set 3',
                weight: '~5% of final grade',
                courseWeight: 'Best 4 of 5 count (20% total)',
                dueTime: 'Thursday, April 3',
                requirements: 'Mathematical microeconomics problems covering markets and equilibrium',
                tips: 'Attend precepts for practice. This is one of 5 - your best 4 count!',
                prepTime: 'Start 3-4 days early'
            },
            'eco310-ps4': {
                title: 'ECO310 Problem Set 4',
                weight: '~5% of final grade',
                courseWeight: 'Best 4 of 5 count (20% total)',
                dueTime: 'Monday, April 13',
                requirements: 'Covers firm behavior and supply',
                tips: 'You can drop one problem set or use 24-hour extension',
                prepTime: 'Start 3-4 days early'
            },
            'eco310-ps5': {
                title: 'ECO310 Problem Set 5 (FINAL)',
                weight: '~5% of final grade',
                courseWeight: 'Best 4 of 5 count (20% total)',
                dueTime: 'Thursday, April 23',
                requirements: 'Final problem set - likely game theory and information economics',
                tips: 'This is your LAST problem set. Make it count!',
                prepTime: 'Start 3-4 days early'
            },
            'mus262-presentation': {
                title: 'MUS262 Oral Presentations (Class Days)',
                weight: '15% of final grade (your specific presentation)',
                courseWeight: 'Major grade component',
                dueTime: 'Various dates: Mar 25, Apr 1, 3, 8, 15, 22',
                requirements: '10-minute presentation on approved topic. Topics approved week of March 18.',
                tips: 'Check which date is YOUR presentation. Rehearse multiple times. Time yourself!',
                prepTime: '3-5 days of preparation recommended'
            },
            'asa201-final': {
                title: 'ASA201 Final Exam',
                weight: '25% of final grade',
                courseWeight: 'Largest single assignment',
                dueTime: 'Saturday, May 9 @ 12:00pm',
                requirements: 'Take-home exam covering entire semester',
                tips: 'Start early in finals period. Review all readings and essays.',
                prepTime: 'Start May 6-7'
            },
            'mus262-final': {
                title: 'MUS262 Final Paper',
                weight: '30% of final grade',
                courseWeight: 'Largest assignment of the semester',
                dueTime: 'Sunday, May 10 @ 7:00pm',
                requirements: '10 pages, double spaced. Thesis required. MLA format. Can cover Early Jazz through 21st Century Modernists.',
                tips: 'Start research in mid-April. Pick a focused topic. Get sources early.',
                prepTime: 'Start research April 15-20'
            },
            'eco310-final': {
                title: 'ECO310 Final Exam',
                weight: '50-60% of final grade',
                courseWeight: 'MOST IMPORTANT - In person mandatory',
                dueTime: 'Tuesday, May 12, 4:00-7:00pm',
                requirements: 'Comprehensive exam covering all material. In-person, department mandated.',
                tips: 'This is worth more than HALF your grade. Start reviewing early May.',
                prepTime: 'Study May 5-12'
            },
            'orf309-final': {
                title: 'ORF309 Final Exam',
                weight: 'TBA - Check Canvas',
                courseWeight: 'Major component',
                dueTime: 'TBA',
                requirements: 'Comprehensive probability and stochastic processes exam',
                tips: 'Date not posted yet. Check Canvas regularly for updates.',
                prepTime: 'TBA - likely 5-7 days'
            },
            'asa201-presentation1': {
                title: 'ASA201 Weekly Presentation #1',
                weight: '0.68% of final grade',
                courseWeight: '15% total (22 presentations)',
                dueTime: 'Tuesday, March 31 (in class)',
                requirements: '5-minute presentation on "Model Minority or Myth?" (Vivian Day Gonzalez reading). Focus on one central idea to discuss with class.',
                tips: 'Not just a summary - pose a question, clarification, or connection to current events. No Canvas post needed this day.',
                prepTime: 'Prepare 2-3 days early'
            },
            'asa201-presentation2': {
                title: 'ASA201 Weekly Presentation #2',
                weight: '0.68% of final grade',
                courseWeight: '15% total (22 presentations)',
                dueTime: 'Tuesday, April 14 (in class)',
                requirements: '5-minute presentation on Stranger Intimacy (Nayan Shah reading). Focus on one central idea to discuss with class.',
                tips: 'Not just a summary - pose a question, clarification, or connection to current events. No Canvas post needed this day.',
                prepTime: 'Prepare 2-3 days early'
            }
        };

        function showModal(assignmentKey) {
            const modal = document.getElementById('assignmentModal');
            const modalBody = document.getElementById('modalBody');
            const details = assignmentDetails[assignmentKey];

            if (!details) return;

            modalBody.innerHTML = `
                <h3>${details.title}</h3>
                <div class="modal-section">
                    <strong>Grade Weight:</strong>
                    <div style="font-size: 1.3em; color: #d32f2f; font-weight: 700;">${details.weight}</div>
                    <div style="color: #6c757d; margin-top: 5px;">${details.courseWeight}</div>
                </div>
                <div class="modal-section">
                    <strong>Due:</strong>
                    <div>${details.dueTime}</div>
                </div>
                <div class="modal-section">
                    <strong>Requirements:</strong>
                    <div>${details.requirements}</div>
                </div>
                <div class="modal-section">
                    <strong>Recommended Prep Time:</strong>
                    <div>${details.prepTime}</div>
                </div>
                <div class="modal-section" style="background: #fff3cd;">
                    <strong>💡 Tips:</strong>
                    <div>${details.tips}</div>
                </div>
            `;

            modal.classList.add('active');
        }

        function closeModal(event) {
            const modal = document.getElementById('assignmentModal');
            if (!event || event.target === modal) {
                modal.classList.remove('active');
            }
        }

        // Toggle prep reminders
        let prepRemindersVisible = true;
        function togglePrepReminders() {
            prepRemindersVisible = !prepRemindersVisible;
            const prepReminders = document.querySelectorAll('.prep-reminder');
            const toggleText = document.getElementById('toggleText');

            prepReminders.forEach(reminder => {
                if (prepRemindersVisible) {
                    reminder.classList.remove('hidden');
                } else {
                    reminder.classList.add('hidden');
                }
            });

            toggleText.textContent = prepRemindersVisible ? 'Hide Prep Reminders ⚡' : 'Show Prep Reminders ⚡';
        }

        // Close modal on Escape key
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeModal();
            }
        });
    </script>
